[0.000, "o", "\u001b[92m──────────────── \u001b[0m\u001b[1;36m2\u001b[0m\u001b[1;36m · Which genes are the busiest drug targets?\u001b[0m\u001b[92m ─────────────────\u001b[0m\r\n"]
[0.605, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33md:D\u001b[0m\u001b[33mrug\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:INTERACTS_WITH_GENE\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mg:Gene\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m RETURN g.gene_name AS \u001b[0m\r\n\u001b[33mgene, \u001b[0m\u001b[1;33mcount\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33md\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS drugs ORDER BY drugs DESC LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.009, "o", "  \u001b[32m→\u001b[0m most-targeted genes \u001b[1m(\u001b[0mCYP enzymes dominate\u001b[1m)\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'AR'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m60\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'CYP3A4'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m46\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[1;32m'CYP2D6'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m39\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'CYP2C19'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m37\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'CYP1A2'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m35\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
[1.404, "o", "\r\n"]
[0.001, "o", "\u001b[92m──────── \u001b[0m\u001b[1;36m3\u001b[0m\u001b[1;36m · Polypharmacy: which drugs collide on a shared gene target?\u001b[0m\u001b[92m ────────\u001b[0m\r\n"]
[0.605, "o", "  \u001b[2mtwo drugs hitting the same gene → potential interaction…\u001b[0m\r\n"]
[1.405, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\r\n\u001b[1;33m(\u001b[0m\u001b[1;33md1:D\u001b[0m\u001b[33mrug\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:INTERACTS_WITH_GENE\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mg:Gene\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m<-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:INTERACTS_WITH_GENE\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33md2:D\u001b[0m\u001b[33mrug\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m \u001b[0m\r\n\u001b[33mWHERE d1.name < d2.name RETURN d1.name AS drug_a, d2.name AS drug_b, g.gene_name\u001b[0m\r\n\u001b[33mAS shared_target ORDER BY shared_target LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.076, "o", "  \u001b[32m→\u001b[0m drug pairs sharing a molecular target: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Cetuximab'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;32m'Trastuzumab'\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;32m'ERBB2'\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Cetuximab'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;32m'Fulvestrant'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;32m'ERBB2'\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Cetuximab'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;32m'Letrozole'\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;32m'ERBB2'\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Cetuximab'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;32m'Lapatinib'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;32m'ERBB2'\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Cetuximab'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;32m'Pelitinib'\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;32m'ERBB2'\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
[1.403, "o", "\r\n"]
[0.001, "o", "\u001b[92m──────────── \u001b[0m\u001b[1;36m4\u001b[0m\u001b[1;36m · Which drugs carry the heaviest side-effect burden?\u001b[0m\u001b[92m ────────────\u001b[0m\r\n"]
[0.605, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33md:D\u001b[0m\u001b[33mrug\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:HAS_SIDE_EFFECT\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mse:SideEffect\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m RETURN d.name AS \u001b[0m\r\n\u001b[33mdrug, \u001b[0m\u001b[1;33mcount\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mse\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS side_effects ORDER BY side_effects DESC LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.078, "o", "  \u001b[32m→\u001b[0m most side effects reported \u001b[1m(\u001b[0mSIDER\u001b[1m)\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Bupropion'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m468\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Doxorubicin'\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;36m453\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Estradiol'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m377\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Naproxen'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m317\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Phenytoin'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m273\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
[1.404, "o", "\r\n"]
[0.000, "o", "\u001b[32m╭──────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1;32mDrug.drugbank_id joins this to clinicaltrials-kg and Gene.gene_name to \u001b[0m      \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1;32mpathways-kg\u001b[0m — targets, interactions,                                         \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m and adverse effects answered on one engine, one Cypher query.                \u001b[32m│\u001b[0m\r\n\u001b[32m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
